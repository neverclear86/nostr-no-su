*.beam
*.ez
/build
# 管理 UI の CSS のビルドと撮影に使う npm のパッケージ。
node_modules
erl_crash.dump
.env

# 外部プラグインのソース側のビルド成果物。*.beam は上の行が拾うが、.app や
# erlang-shipment の中身は拾えない。
plugins-src/*/build

# 外部プラグインの置き場所。中身は環境ごとに違うので追跡しない。
plugins/*
!plugins/.gitkeep

# 秘密をファイルで渡すときの置き場所の例（README の「秘密をファイルで渡す」）。
/secrets/
