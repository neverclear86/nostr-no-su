{
  "kit": "issue-workflow-kit",
  "kitCommit": "153daf65b42f7a7b59ccdcd30238b099f8304daf",
  "config": {
    "values": {
      "REPO": "neverclear86/nostr-no-su",
      "PROJECT_DESC": "Gleam / BEAM の Nostr バンカー兼ユーティリティサーバー",
      "BRANCH_FORM": "`feat/…`、`fix/…`、`docs/…`、`refactor/…` の形で英語",
      "BASE_BRANCH": "main",
      "CLOSE_KEYWORD": "Closes",
      "HELPERS_DIR": "dev",
      "MARKER": "nns",
      "MERGE_METHOD": "squash",
      "WINDOW": 4,
      "PROJECT_PREFIX": "nns",
      "SWEEP_PATHS": "src test dev docs examples README.md README.ja.md CLAUDE.md CONTRIBUTING.md CHANGELOG.md NOTICE LICENSE .env.example setup-env.sh install.sh docker-compose.yml docker-compose.release.yml .claude .github plugins-src docker",
      "DOC_COMMENT_RE": "^///",
      "TEST_PATH_RE": "^test/",
      "DOCS_PATH_RE": "^docs/|[.]md$|^(NOTICE|LICENSE)$",
      "CONFIG_PATH_RE": "^([.]env[.]example|[.]claude/|docker/)|[.](toml|yml|yaml)$",
      "TEST_NAME_RE": "[A-Za-z0-9_]*_test",
      "TEST_DIRS": "test plugins-src/*/test",
      "TEST_GLOB": "*.gleam",
      "TEST_DEF_RE": "^pub fn [A-Za-z0-9_]*_test\\(\\)",
      "TEST_NAME_SED": "s/^pub fn ([A-Za-z0-9_]*_test)\\(\\).*/\\1/",
      "TEST_NAME_FORM": "`名前_test`（Gleam の `pub fn 名前_test()`）",
      "FORMAT_EXT_RE": "[.]gleam$",
      "FORMAT_FILE_CMD": "sh dev/ci_gleam.sh . format",
      "PUSH_CHECK_CMD": "sh dev/ci_gleam.sh . format --check src test dev",
      "MERGE_BUILD_CMD": "gleam build --warnings-as-errors",
      "PROJECT_MARKER_FILE": "gleam.toml"
    },
    "modules": {
      "split": true,
      "design": true,
      "gate": true,
      "ci": true,
      "retro": true,
      "ports": true,
      "plan-tests": true,
      "hooks": true,
      "screenshots": true
    },
    "conditions": {
      "長く動くプロセスを立てる": true,
      "build が外部 API を叩く": false,
      "テストが固定のポートを使う": false,
      "導入先に編集や停止で走る project hooks がある": false,
      "テストが外部の API に接続する": false,
      "複数の platform 向けにイメージを作る": true,
      "変更履歴のファイルを保っている": true
    }
  },
  "files": [
    ".claude/agents/issue-designer.md",
    ".claude/agents/issue-final-gate.md",
    ".claude/agents/issue-implementer.md",
    ".claude/agents/issue-merger.md",
    ".claude/agents/issue-plan-reviewer.md",
    ".claude/agents/issue-planner.md",
    ".claude/agents/issue-pr-lookup.md",
    ".claude/agents/issue-pr-reviewer.md",
    ".claude/agents/issue-retro-implementer.md",
    ".claude/agents/issue-retrospective.md",
    ".claude/skills/issue-workflow/SKILL.md",
    ".claude/skills/issue-workflow/references/formats.md",
    ".claude/workflows/issue-workflow.js",
    ".claude/workflows/retrospective.js",
    "dev/check_plan_tests.sh",
    "dev/check_procedure.sh",
    "dev/dryrun.mjs",
    "dev/hook_format.sh",
