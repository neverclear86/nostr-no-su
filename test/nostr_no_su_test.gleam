import gleeunit

/// テスト全体のエントリポイント。gleeunit が `*_test` 関数を集めて実行する。
///
/// 出力には SUPERVISOR REPORT、pgo のクラッシュレポート、壊れた BEAM を読ませる
/// ときの beam_load のエラー行が混ざる。1 つめは
/// スーパービジョンツリーの復帰を確かめるためにアクターを意図的に kill している
/// ためで、2 つめは到達できない DB を使うテストでプールが接続に失敗するため、
/// 3 つめはプラグインローダーが壊れた BEAM を拒否することを確かめているため。
/// どれも検証したい振る舞いそのものなので、logger の水準は下げずそのまま
/// 出している。
pub fn main() -> Nil {
  gleeunit.main()
}
