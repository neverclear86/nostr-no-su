import gleeunit

/// テスト全体のエントリポイント。gleeunit が `*_test` 関数を集めて実行する。
///
/// 出力には SUPERVISOR REPORT と pgo のクラッシュレポートが混ざる。前者は
/// スーパービジョンツリーの復帰を確かめるためにアクターを意図的に kill している
/// ためで、後者は到達できない DB を使うテストでプールが接続に失敗するため。
/// どちらも検証したい振る舞いそのものなので、logger の水準は下げずそのまま
/// 出している。
pub fn main() -> Nil {
  gleeunit.main()
}
