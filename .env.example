# docker compose で起動するときの設定の雛形。.env に複製し、値を書き換えて使う。
#
# .env の値がアプリに届くのは、docker-compose.yml の ${...} が参照する変数だけ
# である。値を固定している ADMIN_BIND や、docker-compose.yml に足していない
# 自作プラグインの PLUGIN_<NAME>_<KEY> は、.env に書いても効かない。同じ変数が
# シェルの環境変数にもあれば、シェルの値が優先される。変数の意味の詳細は README
# の「環境変数」にある。
#
# 先頭に「# 」を付けた変数の行は無効で、docker-compose.yml の既定値が使われる。
# 書いてある値はその既定値である。変えるときは「# 」を外して書き換える。値を
# 空にしたときの意味は変数ごとに違い、既定値に戻るとは限らない。
# $ や、空白の後の # を含む値は単一引用符で囲む（囲まないと、変数の置き換えや
# 注釈として読まれる）。

# アカウントの秘密鍵と接続 secret を暗号化するマスターキー（必須。32 バイトを 16 進
# で書いた 64 文字）。自動生成しないので、次のコマンドの出力を = の後に書く。
#
#   openssl rand -hex 32
#
# このキーを失うと、保存したアカウントの秘密鍵を復号できなくなる（DB だけでは
# 戻せない）。扱いは README の「マスターキーの扱い」を参照。
ACCOUNT_MASTER_KEY=

# 管理 UI の Basic 認証のパスワード（ユーザー名は admin）。空なら起動ごとに乱数で
# 生成し、ログに出す（最後の行が今のパスワード）。
#
#   docker compose logs nostr-no-su | grep 'generated password' | tail -n 1
#
# 固定するときは推測されにくい値を書く（openssl rand -base64 24 の出力なら、
# 引用符で囲まずに書ける）。
# ADMIN_PASSWORD=

# 監視するリレーの URL（カンマ区切り）。空なら監視を無効にする。
# RELAY_URL=wss://relay.damus.io

# バンカーが購読と応答に使うリレーの URL（カンマ区切り）。空なら RELAY_URL と
# 同じリレー（RELAY_URL も空なら wss://relay.damus.io）を使う。NIP-46 向けの
# リレー（wss://relay.nsec.app など）を勧める。
# BUNKER_RELAY_URL=

# 管理 UI の待ち受けポート。ホストの 127.0.0.1 の同じ番号に公開する。空なら
# 管理 UI を無効にする（ポートの公開は 127.0.0.1:8080 のまま残る）。
# ADMIN_PORT=8080

# 承認ページ（auth_url）の URL の土台にする、管理 UI の公開 URL。空なら
# http://localhost:<ADMIN_PORT> を使う。プロキシー越しや別のホストから管理 UI を
# 開くときに書く。
# ADMIN_BASE_URL=

# バンカーのアカウントを保存する Postgres の URL（必須）。既定は同梱の postgres
# サービスを指す。
# DATABASE_URL=postgres://nostr:nostr@postgres:5432/nostr_no_su

# 外部プラグイン event_logger がイベントを保存する Postgres の URL。既定は同梱の
# postgres サービスを指す。plugins/ に event_logger を置いたときだけ使われる。
# 空なら設定不足として拒否されてプラグインが読み込まれず、イベントは保存されない
# （起動のたびに理由が 1 行出る）。保存をやめるときは、空にするのではなく
# プラグインを置かない。
# PLUGIN_EVENT_LOGGER_DATABASE_URL=postgres://nostr:nostr@postgres:5432/nostr_no_su

# 外部プラグインを探すコンテナー内のディレクトリー（既定の /plugins には、ホストの
# ./plugins を読み取り専用でマウントしている）。空なら外部プラグインを読み込まない。
# PLUGIN_DIR=/plugins

# 例のプラグイン file_logger がイベントを書き出すコンテナー内のパス。plugins/ に
# file_logger を置いたときだけ使われる。空なら設定不足として拒否される。
# PLUGIN_FILE_LOGGER_PATH=/tmp/nostr-no-su-events.log
